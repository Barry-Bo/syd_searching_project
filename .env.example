# 复制成 .env.local 后填入真实值。.env* 已被 gitignore，永远不要提交真实 key。

# --- 离线管线 (Python) ---
# Google Cloud Console → APIs & Services → Credentials
# 记得在 Cloud Console 设预算告警，上限 20 澳元
GOOGLE_PLACES_API_KEY=

# --- LLM（提炼四维卡片 + 解析用户 query）---
# 走 OpenAI 兼容协议。中转站/官方/DeepSeek 都只改这三个值，代码不用动。
# 中转站示例：BASE_URL=https://api.skyning.cc/v1
# 官方示例：  BASE_URL=https://api.openai.com/v1
# DeepSeek：  BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
# 模型 ID 必须从供应商的「模型广场 / models 列表」里原样复制，不要凭印象写
LLM_MODEL=

# --- 数据库 ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 绕过 RLS，只在离线管线用，绝不能带 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=

# --- 埋点 ---
# PostHog → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
